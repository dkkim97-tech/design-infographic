<script>
  function pvShow(fn){
    document.querySelectorAll('.pv-page').forEach(p=>{
      p.style.display = (p.dataset.page===fn) ? 'block' : 'none';
    });
    window.scrollTo(0,0);
    // re-measure any open accordions on the shown page
    document.querySelectorAll('.pv-page[style*="block"] .step.open .step-body').forEach(b=>{ b.style.maxHeight=b.scrollHeight+'px'; });
  }
  document.addEventListener('click', e=>{
    const a=e.target.closest('[data-nav]');
    if(a){ e.preventDefault(); pvShow(a.dataset.nav); }
  });
</script>
