   ========================================================= */

:root{
  --cream:      #F7F3EC;   /* 캔버스 */
  --cream-2:    #FBF8F2;
  --paper:      #FFFFFF;
  --navy:       #1E293B;   /* 다크 네이비 텍스트 */
  --navy-soft:  #334155;
  --ink:        #0F172A;
  --muted:      #6B7280;
  --line:       #E7DFD1;   /* 크림 라인 */
  --line-2:     #EFE8DB;
  --coral:      #E8674C;   /* 포인트 코랄 */
  --coral-dk:   #C9502F;
  --coral-tint: #FBEAE4;
  --gold:       #C79A3B;   /* 골드 하이라이트 */
  --gold-soft:  #E6C98A;
  --shadow:     0 10px 30px rgba(30,41,59,.08);
  --shadow-lg:  0 24px 60px rgba(30,41,59,.16);
  --radius:     16px;
  --maxw:       760px;
}

*{margin:0;padding:0;box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{
  font-family:'Pretendard Variable',Pretendard,-apple-system,BlinkMacSystemFont,
    'Apple SD Gothic Neo','Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;
  color:var(--navy);
  background:
    radial-gradient(1200px 600px at 50% -200px, #FBF6EE 0%, rgba(251,246,238,0) 70%),
    var(--cream);
  line-height:1.6;
  -webkit-font-smoothing:antialiased;
  letter-spacing:-.01em;
}
a{color:inherit;text-decoration:none}
b{font-weight:700;color:var(--ink)}
img{max-width:100%;display:block}

/* ---------- 상단 주차 바 ---------- */
.weekbar{
  position:sticky;top:0;z-index:40;
  background:rgba(247,243,236,.82);
  backdrop-filter:saturate(1.2) blur(10px);
  border-bottom:1px solid var(--line);
}
.weekbar-inner{
  max-width:var(--maxw);margin:0 auto;
  padding:11px 20px;display:flex;align-items:center;justify-content:space-between;gap:14px;
}
.brand{font-size:13px;font-weight:700;color:var(--navy);letter-spacing:-.02em}
.dots{display:flex;gap:8px;align-items:center}
.dot{
  width:30px;height:30px;border-radius:50%;
  display:grid;place-items:center;
  font-size:13px;font-weight:700;color:var(--muted);
  background:var(--paper);border:1px solid var(--line);
  cursor:pointer;transition:.2s;
}
.dot:hover{border-color:var(--gold-soft);color:var(--navy)}
.dot.on{
  background:var(--navy);color:#fff;border-color:var(--navy);
  box-shadow:0 4px 12px rgba(30,41,59,.25);
}
.dot.locked{opacity:.55}
.dot.locked::after{content:"";position:absolute}

/* ---------- 레이아웃 ---------- */
.wrap{max-width:var(--maxw);margin:0 auto;padding:0 20px 72px}

/* ---------- 히어로 매거진 커버 ---------- */
.hero-cover{
  margin:22px 0 8px;border-radius:var(--radius);overflow:hidden;
  border:1px solid var(--line);box-shadow:var(--shadow-lg);
  background:var(--navy);
}
.hero-cover img{width:100%;height:auto}

/* ---------- 헤더 ---------- */
header{padding:30px 0 8px;text-align:left}
.guide-badge{
  display:inline-flex;align-items:center;gap:8px;
  font-size:12px;font-weight:700;color:var(--coral-dk);
  background:var(--coral-tint);border:1px solid #F3D2C7;
  padding:6px 12px;border-radius:999px;letter-spacing:-.01em;
}
.g-dot{width:7px;height:7px;border-radius:50%;background:var(--coral);
  box-shadow:0 0 0 4px rgba(232,103,76,.16)}
.kicker{
  margin-top:18px;font-size:13px;font-weight:700;letter-spacing:.16em;
  text-transform:uppercase;color:var(--gold);
}
h1{
  margin-top:8px;font-size:clamp(34px,7.5vw,54px);
  font-weight:800;line-height:1.08;letter-spacing:-.03em;color:var(--ink);
}
h1 .gold{
  color:var(--coral);
  background:linear-gradient(180deg,transparent 62%, rgba(199,154,59,.28) 62%);
}
.lead{
  margin-top:18px;font-size:16px;color:var(--navy-soft);line-height:1.72;
  max-width:64ch;
}
.lead b{color:var(--ink)}

/* 진행 흐름 chip */
.flow{
  margin-top:22px;display:flex;flex-wrap:wrap;align-items:center;gap:7px;
}
.chip{
  font-size:12.5px;font-weight:700;color:var(--navy-soft);
  background:var(--paper);border:1px solid var(--line);
  padding:6px 12px;border-radius:999px;
}
.chip.now{background:var(--navy);color:#fff;border-color:var(--navy)}
.arw{color:var(--gold-soft);font-weight:700;font-size:13px}

/* ---------- 섹션 라벨 ---------- */
.sect-label{
  margin:38px 0 14px;font-size:12px;font-weight:800;letter-spacing:.14em;
  text-transform:uppercase;color:var(--muted);
  display:flex;align-items:center;gap:12px;
}
.sect-label::after{content:"";flex:1;height:1px;background:var(--line)}

/* ---------- 툴바 ---------- */
.toolbar{display:flex;flex-wrap:wrap;gap:10px}
.tool{
  display:inline-flex;align-items:center;gap:8px;
  font-size:14px;font-weight:700;color:var(--navy);
  background:var(--paper);border:1px solid var(--line);
  padding:11px 16px;border-radius:12px;transition:.18s;
  box-shadow:0 1px 0 rgba(30,41,59,.03);
}
.tool:hover{transform:translateY(-2px);border-color:var(--gold-soft);box-shadow:var(--shadow)}
.tool .ic{
  font-size:12px;font-weight:800;color:var(--coral);
  width:18px;height:18px;display:grid;place-items:center;
  background:var(--coral-tint);border-radius:6px;
}
.tool.primary{background:var(--navy);color:#fff;border-color:var(--navy)}
.tool.primary .ic{background:rgba(255,255,255,.15);color:#fff}
.tool.primary:hover{background:#0F172A;border-color:#0F172A}
.tool.inline{font-size:13.5px;padding:9px 14px}

/* ---------- 스텝 아코디언 ---------- */
.steps{display:flex;flex-direction:column;gap:12px}
.step{
  background:var(--paper);border:1px solid var(--line);
  border-radius:var(--radius);overflow:hidden;transition:.2s;
  box-shadow:0 1px 0 rgba(30,41,59,.03);
}
.step.open{border-color:var(--gold-soft);box-shadow:var(--shadow)}
.step-head{
  display:flex;align-items:center;gap:14px;
  padding:16px 18px;cursor:pointer;user-select:none;
}
.step-num{
  flex:none;width:34px;height:34px;border-radius:10px;
  display:grid;place-items:center;
  font-size:15px;font-weight:800;color:var(--muted);
  background:var(--cream);border:1px solid var(--line);transition:.2s;
}
.step.open .step-num{background:var(--coral);color:#fff;border-color:var(--coral)}
.step-txt{flex:1;min-width:0}
.step-title{font-size:16.5px;font-weight:800;color:var(--ink);letter-spacing:-.02em}
.step-sub{font-size:13px;color:var(--muted);margin-top:2px}
.step-caret{color:var(--gold);font-size:14px;transition:.28s;flex:none}
.step.open .step-caret{transform:rotate(180deg)}
.step-body{max-height:0;overflow:hidden;transition:max-height .32s ease}
.step-inner{padding:2px 18px 22px;border-top:1px solid var(--line-2)}
.step-inner .p{margin-top:14px;font-size:14.5px;color:var(--navy-soft);line-height:1.72}
.step-inner .p b{color:var(--ink)}

/* ---------- 박스 ---------- */
.box{
  margin-top:14px;background:var(--cream-2);
  border:1px solid var(--line);border-radius:12px;padding:14px 16px;
}
.box-head{
  font-size:13.5px;font-weight:700;color:var(--navy);margin-bottom:8px;
  display:flex;align-items:center;gap:8px;flex-wrap:wrap;
}
.box-badge{
  font-size:11px;font-weight:800;letter-spacing:.02em;color:#fff;
  background:var(--navy);padding:3px 9px;border-radius:999px;
}
.ol{list-style:none;display:flex;flex-direction:column;gap:7px}
.ol li{
  position:relative;padding-left:20px;font-size:14px;color:var(--navy-soft);line-height:1.6;
}
.ol li::before{
  content:"";position:absolute;left:2px;top:9px;
  width:6px;height:6px;border-radius:50%;background:var(--gold);
}

/* ---------- 팁 ---------- */
.tip{
  margin-top:12px;font-size:13.5px;color:var(--navy-soft);line-height:1.6;
  background:#FDFBF6;border-left:3px solid var(--gold-soft);
  padding:10px 14px;border-radius:0 10px 10px 0;
}
.tip.spaced{margin-top:18px;background:none;border-left:none;padding:0;
  font-weight:700;color:var(--navy)}

/* ---------- 코드 블록 ---------- */
.code{
  position:relative;margin-top:12px;
  background:var(--ink);border-radius:12px;overflow:hidden;
  border:1px solid #0b1220;box-shadow:var(--shadow);
}
.code pre{
  margin:0;padding:16px 16px 16px;color:#E7ECF3;
  font-family:'IBM Plex Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
  font-size:13px;line-height:1.62;white-space:pre-wrap;word-break:break-word;
  overflow-x:auto;
}
.copy{
  position:absolute;top:10px;right:10px;
  font-size:12px;font-weight:700;color:#cbd5e1;
  background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.16);
  padding:6px 12px;border-radius:8px;cursor:pointer;transition:.16s;
  font-family:inherit;
}
.copy:hover{background:rgba(255,255,255,.16);color:#fff}
.copy.done{background:var(--coral);border-color:var(--coral);color:#fff}

/* ---------- 표 ---------- */
.tbl{
  width:100%;margin-top:14px;border-collapse:separate;border-spacing:0;
  font-size:14px;border:1px solid var(--line);border-radius:12px;overflow:hidden;
  background:var(--paper);
}
.tbl th,.tbl td{padding:11px 14px;text-align:left;border-bottom:1px solid var(--line-2)}
.tbl thead th{
  background:var(--navy);color:#fff;font-weight:700;font-size:12.5px;
  letter-spacing:.02em;
}
.tbl tbody tr:last-child td{border-bottom:none}
.tbl tbody tr:nth-child(even){background:var(--cream-2)}
.tbl td b{color:var(--coral-dk)}

/* ---------- 스킬 태그 ---------- */
.skill-tags{margin-top:12px;display:flex;flex-wrap:wrap;gap:8px}
.skill-tag{
  font-size:13px;color:var(--navy);
  background:var(--paper);border:1px solid var(--line);
  padding:7px 12px;border-radius:999px;
}
.skill-tag b{color:var(--coral-dk);font-weight:700}

/* ---------- 3단 트랙 ---------- */
.tracks{margin-top:16px;display:flex;flex-direction:column;gap:8px}
.track{
  display:flex;gap:12px;align-items:flex-start;
  padding:11px 14px;border-radius:11px;border:1px solid var(--line);
  background:var(--cream-2);
}
.track-badge{
  flex:none;font-size:11px;font-weight:800;color:#fff;
  padding:3px 10px;border-radius:999px;margin-top:1px;
}
.track-txt{font-size:13.5px;color:var(--navy-soft);line-height:1.55}
.track-txt b{color:var(--ink)}
.track--must{border-color:#F3D2C7}
.track--must .track-badge{background:var(--coral)}
.track--vary .track-badge{background:var(--gold)}
.track--chal .track-badge{background:var(--navy)}

/* ---------- 스펙(포트폴리오 6섹션) ---------- */
.specs{margin-top:14px;display:grid;grid-template-columns:repeat(2,1fr);gap:8px}
.spec{
  font-size:13px;color:var(--navy-soft);
  background:var(--cream-2);border:1px solid var(--line);
  padding:9px 12px;border-radius:10px;display:flex;align-items:center;gap:9px;
}
.spec b{
  flex:none;width:22px;height:22px;border-radius:7px;
  display:grid;place-items:center;font-size:12px;color:#fff;background:var(--navy);
}

/* ---------- 마무리 ---------- */
.finish{
  margin-top:38px;padding:26px 22px;border-radius:var(--radius);
  background:linear-gradient(160deg,#20304A 0%, var(--ink) 100%);
  color:#EAF0F8;box-shadow:var(--shadow-lg);
}
.ft{font-size:18px;font-weight:800;color:#fff;letter-spacing:-.02em}
.check{list-style:none;margin-top:16px;display:flex;flex-direction:column;gap:10px}
.check li{
  position:relative;padding-left:30px;font-size:14.5px;color:#D6DEEA;line-height:1.55;
}
.check li b{color:#fff}
.check li::before{
  content:"✓";position:absolute;left:0;top:0;
  width:20px;height:20px;border-radius:6px;font-size:12px;font-weight:800;
  display:grid;place-items:center;color:#fff;background:var(--coral);
}
.port{
  margin-top:20px;padding:13px 16px;border-radius:11px;
  background:rgba(199,154,59,.14);border:1px solid rgba(230,201,138,.32);
  font-size:13.5px;color:#F2E6C9;line-height:1.5;
}
.port b{color:var(--gold-soft)}

/* ---------- 푸터 ---------- */
footer{
  margin-top:40px;padding-top:26px;border-top:1px solid var(--line);
  display:flex;flex-wrap:wrap;gap:14px;justify-content:space-between;align-items:flex-end;
}
.maker .name{font-size:15px;color:var(--ink)}
.maker{font-size:13px;color:var(--muted)}
.tagline{font-size:12.5px;color:var(--muted)}

/* ---------- 준비중 모달 ---------- */
.modal-overlay{
  position:fixed;inset:0;z-index:60;display:none;
  align-items:center;justify-content:center;padding:22px;
  background:rgba(15,23,42,.55);backdrop-filter:blur(4px);
}
.modal-overlay.show{display:flex;animation:fade .2s ease both}
@keyframes fade{from{opacity:0}to{opacity:1}}
.modal{
  width:100%;max-width:400px;background:var(--paper);
  border-radius:18px;overflow:hidden;box-shadow:var(--shadow-lg);
  animation:pop .24s cubic-bezier(.2,.8,.3,1.1) both;
}
@keyframes pop{from{transform:scale(.94) translateY(8px);opacity:0}to{transform:none;opacity:1}}
.m-cover{width:100%;height:auto;background:var(--navy)}
.m-body{padding:20px 22px 24px;text-align:center}
.m-title{font-size:18px;color:var(--ink);font-weight:700}
.m-title b{color:var(--coral)}
.m-desc{margin-top:10px;font-size:13.5px;color:var(--navy-soft);line-height:1.6}
.m-btn{
  margin-top:18px;width:100%;padding:12px;border:none;border-radius:11px;
  background:var(--navy);color:#fff;font-size:14px;font-weight:700;cursor:pointer;
  font-family:inherit;transition:.16s;
}
.m-btn:hover{background:var(--ink)}

/* ---------- 반응형 ---------- */
@media (max-width:560px){
  .wrap{padding:0 16px 60px}
  .weekbar-inner{padding:10px 16px}
  .brand{font-size:12px}
  .specs{grid-template-columns:1fr}
  .step-head{padding:14px 15px;gap:11px}
  .step-inner{padding:2px 15px 20px}
  footer{flex-direction:column;align-items:flex-start;gap:8px}
}

</style>
